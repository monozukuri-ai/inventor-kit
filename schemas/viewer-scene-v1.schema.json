{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventor Kit internal viewer scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_status", "source", "units", "current_state", "complete", "stages", "selection", "candidates", "nodes", "meshes", "properties", "thumbnails", "diagnostics", "tessellation", "assembly", "omissions", "reference_issues"],
  "properties": {
    "schema_version": {"const": 1},
    "job_status": {"enum": ["queued", "running", "finished", "failed"]},
    "source": {
      "type": "object", "required": ["name", "sha256", "kind"], "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "kind": {"type": "string"}}
    },
    "units": {"enum": ["mm", "source_units_unverified"]}, "current_state": {"const": "unverified"}, "complete": {"const": false},
    "stages": {
      "type": "object", "required": ["metadata", "geometry", "conversion", "tessellation"],
      "additionalProperties": false,
      "properties": {"metadata": {"type": "string"}, "geometry": {"type": "string"}, "conversion": {"type": "string"}, "tessellation": {"type": "string"}}
    },
    "drawing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "api_version",
        "status",
        "sheet_status",
        "units",
        "length_unit",
        "millimeters_per_unit",
        "qualified",
        "complete",
        "current_state",
        "sheets",
        "images"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "experimental_partial",
            "unavailable"
          ]
        },
        "sheet_status": {
          "type": "string"
        },
        "units": {
          "const": "source_units_unverified"
        },
        "length_unit": {
          "type": "null"
        },
        "millimeters_per_unit": {
          "type": "null"
        },
        "qualified": {
          "const": false
        },
        "complete": {
          "const": false
        },
        "current_state": {
          "const": "unverified"
        },
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "index",
              "name",
              "status",
              "size_in_source_units",
              "items",
              "omissions",
              "sources",
              "diagnostics"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "experimental_partial",
                  "unavailable"
                ]
              },
              "size_in_source_units": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "geometry",
                    "style",
                    "source",
                    "segment_id",
                    "record_ordinal",
                    "placement_record",
                    "group_path"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "geometry": {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "polyline",
                            "curve",
                            "text",
                            "image"
                          ]
                        }
                      }
                    },
                    "style": {
                      "type": "object"
                    },
                    "source": {
                      "type": "object"
                    }
                  }
                }
              },
              "omissions": {
                "type": "array"
              },
              "sources": {
                "type": "array"
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "resource",
              "status",
              "width",
              "height",
              "sha256",
              "source",
              "diagnostic"
            ],
            "properties": {
              "reference": {
                "type": "integer",
                "minimum": 1
              },
              "resource": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^drawing-image-[0-9]+\\.(png|jpg)$"
              },
              "status": {
                "type": "string"
              },
              "width": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": "object"
              },
              "diagnostic": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "selection": {"type": ["object", "null"]},
    "candidates": {"type": "array", "items": {"type": "object", "required": ["id", "table_status", "profile_status", "state_binding", "source"]}},
    "nodes": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parent", "name", "body_index", "source_sha256", "candidate_id", "mesh_id", "kind", "status", "reason", "local_transform_mm", "world_transform_mm"],
      "properties": {"id": {"type": "string"}, "parent": {"type": ["string", "null"]}, "name": {"type": "string"},
        "body_index": {"type": ["integer", "null"]}, "body_id": {"type": "string", "pattern": "^body-[a-f0-9]{64}$"}, "source_sha256": {"type": ["string", "null"]}, "candidate_id": {"type": ["string", "null"]}, "mesh_id": {"type": ["string", "null"]},
        "kind": {"type": "string"}, "status": {"type": "string"}, "reason": {"type": ["string", "null"]},
        "definition_key": {"type": ["string", "null"]}, "instance_index": {"type": "integer", "minimum": 0},
        "occurrence_path": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
        "local_transform_mm": {"$ref": "#/$defs/matrix"}, "world_transform_mm": {"$ref": "#/$defs/matrix"},
        "suppressed": {"type": ["boolean", "null"]}, "visible": {"type": ["boolean", "null"]}, "substitute": {"type": ["boolean", "null"]}, "source": {"type": "object"}}
    }},
    "meshes": {"type": "array", "items": {
      "type": "object", "required": ["id", "buffers", "bounds", "face_count", "triangle_count"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "bounds": {"$ref": "#/$defs/bounds"},
        "face_count": {"type": "integer", "minimum": 1}, "triangle_count": {"type": "integer", "minimum": 1},
        "buffers": {"type": "object", "required": ["vertices", "triangles", "normals", "edges", "triangles_per_face", "segments_per_edge", "face_types", "edge_types", "obj_vertices"],
          "additionalProperties": {"$ref": "#/$defs/buffer"}}
      }
    }},
    "properties": {"type": "array", "items": {"type": "object", "required": ["name", "value", "value_kind", "source", "storage_scope", "state_binding", "fmtid", "pid", "status"]}},
    "thumbnails": {"type": "array", "items": {"type": "object", "required": ["resource", "width", "height", "source", "state_binding", "validation"],
      "properties": {"resource": {"$ref": "#/$defs/resource"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}},
    "diagnostics": {"type": "array", "items": {"type": "object", "required": ["code", "severity", "message", "source"],
      "properties": {"code": {"type": "string"}, "severity": {"type": "string"}, "message": {"type": "string"}}}},
    "tessellation": {"type": ["object", "null"], "required": ["quality", "linear_deflection_mm", "angular_deflection_radians", "mode", "triangle_count", "buffer_bytes", "packages"]},
    "part": {"type": ["object", "null"], "required": ["schema_version", "kind", "status", "bodies", "omissions", "geometry_complete", "selection_complete", "current_state_verified"],
      "properties": {"kind": {"const": "part"}, "current_state_verified": {"const": false}}},
    "assembly": {"type": ["object", "null"], "required": ["structure_status", "current_state", "complete", "allow_unverified_state", "allow_partial", "converted_instances", "converted_definitions", "displayed_instances", "displayed_definitions", "source_documents"],
      "properties": {"current_state": {"const": "unverified"}, "complete": {"const": false}}},
    "omissions": {"type": "array", "items": {"type": "object", "required": ["instance", "path", "reason", "detail"]}},
    "reference_issues": {"type": "array", "items": {"type": "object", "required": ["owner", "status"]}}
  },
  "$defs": {
    "matrix": {"type": ["array", "null"], "minItems": 4, "maxItems": 4,
      "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}},
    "resource": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+\\.(bin|png)$"},
    "buffer": {"type": "object", "required": ["resource", "dtype", "count", "bytes"], "additionalProperties": false,
      "properties": {"resource": {"$ref": "#/$defs/resource"}, "dtype": {"enum": ["float32", "uint32"]},
        "count": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}}},
    "bounds": {"type": "object", "required": ["xmin", "xmax", "ymin", "ymax", "zmin", "zmax"],
      "additionalProperties": false, "properties": {"xmin": {"type": "number"}, "xmax": {"type": "number"}, "ymin": {"type": "number"}, "ymax": {"type": "number"}, "zmin": {"type": "number"}, "zmax": {"type": "number"}}}
  }
}
